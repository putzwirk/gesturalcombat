{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.putzwirk.gesturalcombat.GesturalcombatFabric"
        ],
        "client": [
            "com.putzwirk.gesturalcombat.GesturalcombatFabricClient"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16",
        "fabric": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=21",
        "bettercombat": ">=2.0.0",
        "playeranimator": ">=2.0.0"
    }
}
